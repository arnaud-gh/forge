rules_version = '2';

// Forge security rules (PRD section 9): all user data lives under users/{uid}
// and is readable/writable only by that signed-in user. Everything else denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
